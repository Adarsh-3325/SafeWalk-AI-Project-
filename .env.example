# Application Settings
APP_NAME=SafeWalk-AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Keys (Optional - System will run in Mock Mode if empty)
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
USE_MOCK_DATA=true

# Database Configuration (MySQL default, SQLite fallback if MySQL is unconfigured)
DATABASE_URL=sqlite:///./safewalk.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=safewalk_db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api

# Streamlit Frontend Configuration
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000

# Scoring Weights
SAFETY_WEIGHT=0.70
TIME_WEIGHT=0.20
DISTANCE_WEIGHT=0.10
